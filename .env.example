# Resend server credentials. Copy this file to .env and replace the examples.
# Never expose RESEND_API_KEY with a PUBLIC_ prefix.
RESEND_API_KEY="re_replace_with_your_api_key"

# The sender must belong to a domain verified in Resend.
CONTACT_FROM_EMAIL="Machu Picchu Tours <bookings@machupicchutour.com>"
CONTACT_TO_EMAIL="info@machupicchutour.com"
