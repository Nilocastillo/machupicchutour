---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ToursSection from '../components/ToursSection.astro';
import PackagesSection from '../components/PackagesSection.astro';
import DestinationsSection from '../components/DestinationsSection.astro';
import BlogSection from '../components/BlogSection.astro';
import FaqSection from '../components/FaqSection.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import CertificationsSection from '../components/CertificationsSection.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import { machuPicchuTours } from '../data/home';
---

<Layout
	title="Machu Picchu Tours | Tours & Travel Packages in Peru 2026"
	description="Book your Peru tours: Machu Picchu, Cusco, Amazon and more. Authentic experiences with expert local guides. Best price guaranteed."
>
	<Header />

	<main id="top">
		<Hero />
		<ToursSection
			id="tours"
			theme="neutral"
			layout="bento"
			eyebrow="Machu Picchu tours"
			title={'Our most booked<br /><em class="font-normal text-ink/52">Machu Picchu tours.</em>'}
			description="Favorite itineraries chosen by travelers—from short cultural journeys to the Inca Trail and locally designed trekking adventures."
			tours={machuPicchuTours}
			footerText="See all Machu Picchu tours"
			footerHref="/machu-picchu-tours"
		/>
		<PackagesSection />
		<DestinationsSection />
		<BlogSection />
		<FaqSection />
		<ReviewsSection />
		<CertificationsSection />
		<FinalCta />
	</main>

	<Footer />

	<a class="fixed right-4 bottom-4 z-40 grid size-14 place-items-center rounded-full bg-[#25d366] text-white shadow-2xl transition hover:scale-105 sm:right-6 sm:bottom-6" href="https://wa.me/51925422602" target="_blank" rel="nofollow noreferrer" aria-label="Chat on WhatsApp">
		<svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-none stroke-current" stroke-width="1.7"><path d="M20 11.6a8 8 0 0 1-11.8 7L4 20l1.4-4.1A8 8 0 1 1 20 11.6Z" stroke-linejoin="round"></path><path d="M9 8.5c.5 2.4 1.7 3.7 4.4 4.8l1.2-1.1 2 .9c.2 1.2-.8 2-2.1 2C10.6 14.7 8.1 12.2 8 9c0-.7.4-1.1 1-1.3l.8 1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
	</a>

	<script>
		const revealItems = document.querySelectorAll('.reveal');
		if ('IntersectionObserver' in window) {
			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			}, { threshold: 0.06, rootMargin: '0px 0px -40px' });
			revealItems.forEach((item) => observer.observe(item));
		} else {
			revealItems.forEach((item) => item.classList.add('is-visible'));
		}
	</script>
</Layout>
