---
import { certifications } from '../data/home';
---

<section class="section-boundary overflow-hidden bg-mist py-20 sm:py-28 lg:py-36" aria-labelledby="certifications-title">
	<div class="page-shell">
		<div class="reveal grid overflow-hidden rounded-[2rem] border border-ink/10 bg-mist shadow-[0_30px_90px_rgba(21,25,22,0.1)] lg:grid-cols-[0.72fr_1.6fr]">
			<div class="relative flex min-h-[25rem] flex-col justify-between overflow-hidden border-b border-ink/10 bg-ink p-7 text-white sm:p-10 lg:min-h-full lg:border-r lg:border-b-0 lg:p-12">
				<div class="relative">
					<p class="eyebrow text-white/46">Verified credentials</p>
					<h2 id="certifications-title" class="mt-7 font-display text-[clamp(2.8rem,4.8vw,5.1rem)] font-medium leading-[0.88] tracking-[-0.045em]">Travel associations<br /><em class="font-normal text-white/45">& certifications.</em></h2>
				</div>
				<div class="relative mt-14 flex items-center gap-4 border-t border-white/14 pt-6">
					<span class="grid size-11 shrink-0 place-items-center rounded-full border border-white/20 text-white/70">
						<svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="1.6"><path d="M12 3 20 6v6c0 5-3.4 8-8 10-4.6-2-8-5-8-10V6z"></path><path d="m8.5 12 2.2 2.2 4.8-5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					</span>
					<p class="text-[0.68rem] leading-5 text-white/72">A legally registered Peru tour operator with recognized regional credentials and trusted booking partners.</p>
				</div>
			</div>

			<div class="grid grid-cols-2 sm:grid-cols-4">
				{certifications.map((item, index) => (
					<div class:list={[
						'certification-mark group relative flex min-h-44 flex-col items-center justify-center border-ink/10 p-5 sm:min-h-52 sm:p-7',
						index % 2 !== 0 && 'border-l',
						index > 1 && 'border-t',
						index % 4 !== 0 && 'sm:border-l',
						index > 3 && 'sm:border-t',
						index > 1 && index < 4 && 'sm:border-t-0',
					]}>
						<div class="flex h-16 w-full items-center justify-center sm:h-20">
							<img class="max-h-full max-w-[82%] object-contain grayscale transition duration-500 group-hover:scale-105 group-hover:grayscale-0" src={item.image} alt={`${item.name} logo`} loading="lazy" decoding="async" />
						</div>
						<p class="mt-5 text-center text-[0.46rem] font-extrabold tracking-[0.14em] text-ink/36 uppercase">{item.type}</p>
					</div>
				))}
			</div>
		</div>
	</div>
</section>
