---
import type { TourFaqItem } from "../../data/tour-details";

interface Props {
	items: TourFaqItem[];
}

const { items } = Astro.props;
---

<section id="tour-faq" class="scroll-mt-8 border-t border-ink/12 pt-12 sm:pt-16">
	<p class="text-[9px] font-extrabold tracking-[0.16em] text-ink/62 uppercase">Good to know</p>
	<h2 class="mt-4 font-sans text-[clamp(2rem,3.5vw,3.35rem)] font-extrabold leading-[0.98] tracking-[-0.045em] text-ink">Frequently asked questions</h2>
	<p class="mt-5 max-w-2xl text-sm leading-7 text-ink/74">Clear answers about this tour before you reserve.</p>

	<div class="mt-9 border-t border-ink/12">
		{items.map((item, index) => (
			<details class="group border-b border-ink/12" open={index === 0}>
				<summary class="flex cursor-pointer list-none select-none items-start justify-between gap-6 py-5 sm:py-6">
					<h3 class="max-w-2xl text-sm font-extrabold leading-6 text-ink/88 sm:text-base">{item.question}</h3>
					<svg aria-hidden="true" viewBox="0 0 16 16" class="mt-1 size-4 shrink-0 fill-none stroke-current text-ink/58 transition group-open:rotate-180" stroke-width="1.7"><path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</summary>
				<p class="max-w-3xl pb-6 pr-10 text-sm leading-7 text-ink/74">{item.answer}</p>
			</details>
		))}
	</div>
</section>
