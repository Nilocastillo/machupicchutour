---
import type { TourFactIconName } from "../../data/tour-details";

interface Props {
	name: TourFactIconName;
}

const { name } = Astro.props;
---

<svg aria-hidden="true" viewBox="0 0 24 24" class="size-[1.05rem] fill-none stroke-current" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
	{name === "duration" && (
		<>
			<circle cx="12" cy="12" r="8.5"></circle>
			<path d="M12 7.5v5l3.25 2"></path>
		</>
	)}
	{name === "service" && (
		<>
			<path d="M8.2 11.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z"></path>
			<path d="M2.8 19.2v-1.4a5.4 5.4 0 0 1 10.8 0v1.4"></path>
			<path d="M15.4 5.2a3.2 3.2 0 0 1 0 6.2M17 13a5.4 5.4 0 0 1 4.2 5.2v1"></path>
		</>
	)}
	{name === "pickup" && (
		<>
			<path d="M4 14V7.8A1.8 1.8 0 0 1 5.8 6h8.7l3.5 4.2V18"></path>
			<path d="M4 14h14M18 10.2h-4V6M7.2 18.8a2.2 2.2 0 1 0 0-4.4 2.2 2.2 0 0 0 0 4.4ZM17.5 18.8a2.2 2.2 0 1 0 0-4.4 2.2 2.2 0 0 0 0 4.4Z"></path>
		</>
	)}
	{name === "cancellation" && (
		<>
			<path d="M12 3.5 19 6v5.2c0 4.4-2.8 7.6-7 9.3-4.2-1.7-7-4.9-7-9.3V6l7-2.5Z"></path>
			<path d="m9.3 9.3 5.4 5.4M14.7 9.3l-5.4 5.4"></path>
		</>
	)}
	{name === "guide" && (
		<>
			<path d="M4 5.2c3.1-.7 5.8-.1 8 1.6v12c-2.2-1.7-4.9-2.3-8-1.6v-12ZM20 5.2c-3.1-.7-5.8-.1-8 1.6v12c2.2-1.7 4.9-2.3 8-1.6v-12Z"></path>
			<path d="M12 6.8v12"></path>
		</>
	)}
	{name === "difficulty" && (
		<>
			<path d="m3.5 18 5.4-8.1 3.2 4.2 2.5-3.2 5.9 7.1h-17Z"></path>
			<path d="m7.8 11.5 1.1-1.6 3.2 4.2"></path>
		</>
	)}
</svg>
