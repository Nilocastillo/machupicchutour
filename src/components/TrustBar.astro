---
import { trustMarks } from '../data/home';
---

<section aria-label="Why travelers trust us" class="bg-paper py-8 sm:py-12">
	<div class="page-shell grid grid-cols-2 overflow-hidden rounded-[1.4rem] border border-ink/10 bg-white shadow-soft lg:grid-cols-4">
		{trustMarks.map((item, index) => (
			<div class:list={['flex min-h-28 items-center gap-4 p-5 sm:p-6', index % 2 !== 0 && 'border-l border-ink/10', index > 1 && 'border-t border-ink/10 lg:border-t-0', index === 2 && 'lg:border-l']}>
				<span class="grid size-11 shrink-0 place-items-center rounded-xl bg-ink/6 text-ink/58">
					{item.icon === 'star' ? (
						<svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current"><path d="m12 2.7 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9z"></path></svg>
					) : item.icon === 'shield' ? (
						<svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="1.8"><path d="M12 3 20 6v6c0 5-3.4 8-8 10-4.6-2-8-5-8-10V6z"></path><path d="m8.5 12 2.2 2.2 4.8-5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					) : item.icon === 'support' ? (
						<svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="1.8"><path d="M4 13v-1a8 8 0 0 1 16 0v1M4 13h2.5v6H5a2 2 0 0 1-2-2v-2a2 2 0 0 1 1-2Zm16 0h-2.5v6H19a2 2 0 0 0 2-2v-2a2 2 0 0 0-1-2Z"></path></svg>
					) : (
						<svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="1.8"><path d="M8 4h8v4a4 4 0 0 1-8 0zM8 6H5a2 2 0 0 0 2 4h1m8-4h3a2 2 0 0 1-2 4h-1M12 12v5m-4 3h8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					)}
				</span>
				<p><strong class="block text-sm font-extrabold">{item.title}</strong><span class="mt-1 block text-xs text-ink/48">{item.detail}</span></p>
			</div>
		))}
	</div>
</section>
