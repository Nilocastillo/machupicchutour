---
import SectionHeading from './SectionHeading.astro';
import { destinations } from '../data/home';
---

<section id="destinations" class="overflow-hidden bg-ink py-20 text-white sm:py-28 lg:py-36">
	<div class="page-shell">
		<div class="reveal grid gap-10 lg:grid-cols-[1.08fr_0.72fr] lg:items-end">
			<SectionHeading
				theme="dark"
				eyebrow="Build your own Peru story"
				title={'Popular destinations you can combine<br /><em class="font-normal text-white/48">with your Machu Picchu tour.</em>'}
			/>
			<p class="max-w-xl text-sm leading-7 text-white/74">Machu Picchu is the highlight of any Peru trip, but the country offers much more. Our Machu Picchu tours can be easily combined with:</p>
		</div>

		<div class="destination-panels reveal mt-14 flex flex-col overflow-hidden rounded-[1.8rem] border border-white/12 lg:h-[38rem] lg:flex-row">
			{destinations.map((destination, index) => (
				<article class:list={['destination-panel group relative min-h-[25rem] overflow-hidden border-white/14', index < destinations.length - 1 && 'border-b lg:border-r lg:border-b-0']} style={`--item-index: ${index}`}>
					<img class="absolute inset-0 size-full object-cover transition duration-700 ease-out group-hover:scale-[1.045]" src={destination.image} alt={destination.title} loading="lazy" />
					<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/10 to-black/25"></div>
					<div class="absolute inset-x-0 top-0 flex items-start justify-end p-5 sm:p-6">
						<span class="grid size-11 place-items-center rounded-full bg-sun/88 text-white transition group-hover:-rotate-12 group-hover:bg-sun">
							<svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-none stroke-current" stroke-width="1.8"><path d="M5 19 19 5M9 5h10v10" stroke-linecap="round" stroke-linejoin="round"></path></svg>
						</span>
					</div>
					<div class="absolute inset-x-0 bottom-0 p-6 sm:p-7">
						<p class="text-[8px] font-extrabold tracking-[0.15em] text-white/52 uppercase">{destination.note}</p>
						<h3 class="mt-3 max-w-xs font-sans text-[1.85rem] font-extrabold leading-none tracking-[-0.035em] sm:text-[2.1rem]">{destination.title}</h3>
					</div>
					<a class="absolute inset-0" href={destination.href} aria-label={`Explore ${destination.title}`}></a>
				</article>
			))}
		</div>
	</div>
</section>
