---
import type { Tour } from '../data/home';

interface Props extends Tour {
	index?: number;
}

const { image, title, href, duration, price, oldPrice, tag = 'Complete itinerary', index = 0 } = Astro.props;
---

<article class="package-card group grid min-h-[24rem] overflow-hidden rounded-[1.5rem] border border-ink/10 bg-ink/[0.025] shadow-[0_18px_55px_rgba(21,25,22,0.08)] sm:min-h-[22rem] sm:grid-cols-[0.9fr_1.1fr]" style={`--item-index: ${index}`}>
	<a class="relative min-h-64 overflow-hidden sm:min-h-full" href={href} aria-label={`View ${title}`}>
		<img class="size-full object-cover transition duration-700 ease-out group-hover:scale-[1.045]" src={image} alt={title} loading="lazy" />
		<div class="absolute inset-0 bg-gradient-to-t from-black/45 to-transparent"></div>
	</a>

	<div class="flex flex-col p-6 sm:p-7">
		<div class="flex items-center justify-between gap-3 text-[9px] font-extrabold tracking-[0.13em] text-ink/42 uppercase">
			<span>{duration}</span>
			<span>{tag}</span>
		</div>
		<h3 class="mt-5 font-sans text-[1.45rem] font-extrabold leading-[1.12] tracking-[-0.03em] text-ink sm:text-[1.6rem]">{title}</h3>
		<div class="mt-auto flex items-end justify-between gap-4 border-t border-ink/10 pt-6">
			<div>
				<p class="text-[8px] font-extrabold tracking-[0.13em] text-ink/38 uppercase">Per person</p>
				<p class="mt-1"><span class="mr-2 text-xs text-ink/32 line-through">{oldPrice}</span><strong class="font-sans text-2xl font-extrabold tracking-[-0.04em] text-ink">{price}</strong></p>
			</div>
			<a class="grid size-12 shrink-0 place-items-center rounded-full bg-sun/88 text-white transition hover:-rotate-12 hover:bg-sun" href={href} aria-label={`View ${title}`}>
				<svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-none stroke-current" stroke-width="1.8"><path d="M5 19 19 5M9 5h10v10" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			</a>
		</div>
	</div>
</article>
